{
  "name": "ai-success-network",
  "private": true,
  "type": "module",
  "description": "A verified AI-tool decision system for individual customer success managers.",
  "license": "MIT",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "validate:data": "node scripts/validate-data.ts",
    "verify:quotes": "node scripts/verify-quotes.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "3.2.1",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
